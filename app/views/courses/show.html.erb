<h1>课程详情</h1>

<p><strong>课程名：</strong><%= @course.name %></p>
<p><strong>学分：</strong><%= @course.credit %></p>

<h2>选课学生</h2>
<table border="1" cellpadding="5">
  <tr>
    <th>学生</th>
    <th>专业</th>
    <th>成绩</th>
  </tr>
  <% @enrollments.each do |enrollment| %>
    <tr>
      <td><%= enrollment.student.name %></td>
      <td><%= enrollment.student.major %></td>
      <td><%= enrollment.score || "未打分" %></td>
    </tr>
  <% end %>
</table>

<p>
  <%= link_to "返回", courses_path %> |
  <%= link_to "选课", new_course_enrollment_path(@course) %>
</p>
</p>