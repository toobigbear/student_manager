<h1>新建课程</h1>

<%= form_with model: @course do |form| %>
  <% if @course.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@course.errors.count, "个错误") %>：</h2>
      <ul>
        <% @course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "课程名" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :credit, "学分" %>
    <%= form.number_field :credit %>
  </div>

  <div>
    <%= form.submit "创建" %>
  </div>
<% end %>

<%= link_to "返回", courses_path %>