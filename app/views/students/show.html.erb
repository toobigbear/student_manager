<h1>学生详情</h1>

<p><strong>姓名：</strong><%= @student.name %></p>
<p><strong>年龄：</strong><%= @student.age %></p>
<p><strong>专业：</strong><%= @student.major %></p>
<p><strong>平均分：</strong><%= @student.average_score %></p>

<h2>已选课程</h2>
<table border="1" cellpadding="5">
  <tr>
    <th>课程</th>
    <th>学分</th>
    <th>成绩</th>
  </tr>
  <% @enrollments.each do |enrollment| %>
    <tr>
      <td><%= enrollment.course.name %></td>
      <td><%= enrollment.course.credit %></td>
      <td><%= enrollment.score || "未打分" %></td>
    </tr>
  <% end %>
</table>

<p>
  <%= link_to "返回", students_path %> |
  <%= link_to "选课", new_student_enrollment_path(@student) %>
</p>