<h1>新建学生</h1>

<%= form_with model: @student do |form| %>
  <% if @student.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@student.errors.count, "个错误") %>：</h2>
      <ul>
        <% @student.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "姓名" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :age, "年龄" %>
    <%= form.number_field :age %>
  </div>

  <div>
    <%= form.label :major, "专业" %>
    <%= form.text_field :major %>
  </div>

  <div>
    <%= form.submit "创建" %>
  </div>
<% end %>

<%= link_to "返回", students_path %>